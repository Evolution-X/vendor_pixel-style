prebuilt_etc {
    name: "pixel_charger_res_images_charger_battery_scale",
    filename: "battery_scale.png",
    src: "images/charger/battery_scale.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "pixel_charger_res_images_charger_battery_scale_vendor",
    filename: "battery_scale.png",
    src: "images/charger/battery_scale.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_res_images_charger_battery_fail",
    filename: "battery_fail.png",
    src: "images/charger/battery_fail.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "pixel_charger_res_images_charger_battery_fail_vendor",
    filename: "battery_fail.png",
    src: "images/charger/battery_fail.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "pixel_charger_res_images_charger_main_font",
    filename: "main_font.png",
    src: "images/charger/main_font.png",
    relative_install_path: "res/images/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "pixel_charger_res_images_charger_main_font_vendor",
    filename: "main_font.png",
    src: "images/charger/main_font.png",
    relative_install_path: "res/images/charger",
    proprietary: true,
}

prebuilt_etc {
    name: "product_charger_res_images",
    filename: "animation.txt",
    required: [
        "pixel_charger_res_images_charger_battery_fail",
        "pixel_charger_res_images_charger_battery_scale",
        "pixel_charger_res_images_charger_main_font",
    ],
    src: "values/charger/animation.txt",
    relative_install_path: "res/values/charger",
    product_specific: true,
}

prebuilt_etc {
    name: "product_charger_res_images_vendor",
    filename: "animation.txt",
    required: [
        "pixel_charger_res_images_charger_battery_fail_vendor",
        "pixel_charger_res_images_charger_battery_scale_vendor",
        "pixel_charger_res_images_charger_main_font_vendor",
    ],
    src: "values/charger/animation.txt",
    relative_install_path: "res/values/charger",
    proprietary: true,
}
